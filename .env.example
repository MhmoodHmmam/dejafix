# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic API key (ANTHROPIC_API_KEY is also accepted)
CLAUDE_API_KEY=
# Meko Cloud API key, created in https://cloud.mekodata.ai
MEKO_API_KEY=
# UUID of the datapack DejaFix uses. Create the datapack in the Meko Cloud portal first:
# over MCP, conversation_create needs a datapack and datapack_create needs a conversation.
MEKO_DATAPACK_ID=

# Optional overrides
# MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# MEKO_TIMEOUT_SECONDS=30
# DEJAFIX_MODEL=claude-opus-5-5

# Database: SQLite (db.sqlite3) unless DEJAFIX_DB_HOST is set. `manage.py provision_db` creates a
# Postgres cluster in Meko and appends these for you; for any other Postgres, set them all here.
# TLS is always required.
# DEJAFIX_DB_HOST=
# DEJAFIX_DB_PORT=5432
# DEJAFIX_DB_NAME=
# DEJAFIX_DB_USER=
# DEJAFIX_DB_PASSWORD=
# DEJAFIX_DB_SSLMODE=require

# Django (local development)
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Behind HTTPS (not for the local demo): secure cookies, HTTPS redirect and HSTS.
# DJANGO_HTTPS=1
# DJANGO_HSTS_SECONDS=3600
